# App Store Connect API Key authentication
# Download .p8 key from App Store Connect > Users and Access > Keys
ASC_KEY_ID=YOUR_KEY_ID
ASC_ISSUER_ID=YOUR_ISSUER_ID
ASC_PRIVATE_KEY_PATH=./AuthKey.p8

# Optional: Inline private key (alternative to file path)
# ASC_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Optional: SMTP for responding to tester feedback via email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
APP_NAME=My App

# Optional: Playwright browser auth for full feedback text
# Set to "true" to enable browser-based access to iris API
ENABLE_BROWSER_AUTH=false
ASC_USERNAME=
ASC_PASSWORD=
